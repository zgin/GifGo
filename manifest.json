{
    "manifest_version": 3,
    "name": "GifGo",
    "version": "2.0",
    "icons": {
      "128": "images/gifgo_logo.png"
    },
    "description": "Search Giphy, copy GIF links or images, and save favorites",
    "permissions": ["storage", "clipboardWrite"],
    "host_permissions": [
      "https://api.giphy.com/*",
      "https://*.giphy.com/*"
    ],
    "action": {
      "default_popup": "popup.html"
    }
}
